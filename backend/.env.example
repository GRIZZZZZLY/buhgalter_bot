# Core
TELEGRAM_BOT_TOKEN=8711512009:AAHo3kJdbZm0T_DWLLQgb1Wot3LVw2OFmKk
TELEGRAM_MODE=polling
DATABASE_URL=sqlite:///./finance_bot.db

# Telegram runtime
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# CORS — comma-separated allowed origins for the WebApp.
# Leave empty in dev (allows all). Set in production:
# CORS_ORIGINS=https://your-domain.com
CORS_ORIGINS=

# STT
STT_PROVIDER=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_TEMPERATURE=0.0
WHISPER_INITIAL_PROMPT=Финансовый ассистент. Русская речь. Возможны категории: еда, продукты, самокат, такси, транспорт, бензин, заправка, зарплата, аванс, клиент, заказ, фриланс.
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_MODEL_PATH=
STT_MIN_CONFIDENCE=0.6
FFMPEG_BIN=ffmpeg

# LLM (OpenRouter)
OPENROUTER_API_KEY=
LLM_MODEL=minimax/minimax-m1:free
